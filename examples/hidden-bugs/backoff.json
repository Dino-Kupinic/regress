{
  "source": "src/backoff.ts",
  "test": "test/backoff.test.ts",
  "oracle": "oracle/backoff.oracle.ts",
  "bugs": [
    {
      "id": "backoff-linear-growth",
      "description": "Delays grow linearly instead of exponentially.",
      "find": "baseMs * factor ** (attempt - 1))",
      "replace": "baseMs * (1 + (factor - 1) * (attempt - 1)))"
    },
    {
      "id": "backoff-uncapped",
      "description": "The maximum delay is ignored.",
      "find": "Math.min(maxMs, baseMs * factor ** (attempt - 1))",
      "replace": "baseMs * factor ** (attempt - 1)"
    },
    {
      "id": "backoff-equal-jitter-floor",
      "description": "Equal jitter forgets the guaranteed half of the delay.",
      "find": "Math.floor(exponential / 2 + random() * (exponential / 2))",
      "replace": "Math.floor(random() * (exponential / 2))"
    },
    {
      "id": "backoff-options-ignored",
      "description": "Defaults override caller options.",
      "find": "{ ...DEFAULT_BACKOFF, ...options }",
      "replace": "{ ...options, ...DEFAULT_BACKOFF }"
    },
    {
      "id": "retry-constant-delay",
      "description": "Every retry waits the first delay instead of backing off.",
      "find": "backoffDelay(attempt, backoff, random)",
      "replace": "backoffDelay(1, backoff, random)"
    }
  ]
}
