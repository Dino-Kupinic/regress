{
  "source": "src/password.ts",
  "test": "test/password.test.ts",
  "oracle": "oracle/password.test.ts",
  "bugs": [
    {
      "id": "password-forbidden-case-sensitive",
      "description": "Forbidden words are only matched case-sensitively.",
      "find": "lower.includes(word)",
      "replace": "password.includes(word)"
    },
    {
      "id": "password-double-repeat",
      "description": "Two repeated characters are already flagged.",
      "find": "/(.)\\1\\1/",
      "replace": "/(.)\\1/"
    },
    {
      "id": "password-underscore-not-symbol",
      "description": "An underscore no longer counts as a symbol.",
      "find": "!/[^A-Za-z0-9]/.test(password)",
      "replace": "!/[^A-Za-z0-9_]/.test(password)"
    },
    {
      "id": "password-long-threshold",
      "description": "The long-password bonus starts at 16 instead of 14 characters.",
      "find": "password.length >= 14",
      "replace": "password.length >= 16"
    },
    {
      "id": "password-fair-threshold",
      "description": "Passwords need three points instead of two to be fair.",
      "find": "if (score >= 2) return \"fair\";",
      "replace": "if (score >= 3) return \"fair\";"
    }
  ]
}
